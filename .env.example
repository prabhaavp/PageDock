APP_NAME=Document Studio
PRINTER_NAME=My printer
APP_PASSWORD=replace-with-a-unique-long-random-password
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PRINTER_HOST=192.0.2.10
PRINTER_PORT=9100
# Run: docker run --rm --entrypoint sh ghcr.io/prabhaavp/pagedock:latest -c 'cupsd && lpinfo -m'
PRINTER_DRIVER=replace-with-exact-cups-driver-id
CUPS_QUEUE=printer
UNDO_DEPTH=3
MEMORY_LIMIT=1g
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
# For access through HTTPS, set both values, e.g. PUBLIC_ORIGIN=https://print.example.com
PUBLIC_ORIGIN=
SECURE_COOKIE=0
